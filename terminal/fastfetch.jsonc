{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "D:\\Tools\\terminal\\assets\\firefly-small.txt",
        "padding": { "top": 3, "left": 1, "right": 2 }
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "cyan",
            "title": "yellow"
        },
        "percent": {
            "color": { "green": "green", "yellow": "green", "red": "green" }
        }
    },
    "modules": [
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
        "separator",
        { "type": "os",       "key": "  OS    " },
        { "type": "kernel",   "key": "  Kernel" },
        { "type": "uptime",   "key": "  Uptime" },
        { "type": "shell",    "key": "  Shell " },
        { "type": "terminal", "key": "  Term  " },
        { "type": "custom",   "format": "{#90}────────────────────────────────────────{#}" },
        { "type": "cpu", "key": "  CPU   ", "format": "lua:local c=...; local n=c.name:gsub('%(R%)',''):gsub('%(TM%)',''):gsub('%s+',' '); return n .. (c.coreTypes ~= '' and (' ('..c.coreTypes..')') or '') .. (c.freqBase ~= '' and (' @ '..c.freqBase) or '')" },
        { "type": "gpu", "hideType": "integrated", "key": "󰢮  GPU   ",  "format": "lua:local g=...; local n=g.name:gsub('%(R%)',''):gsub('%(TM%)',''):gsub('^NVIDIA ',''):gsub('^GeForce ',''):gsub(' GPU$',''):gsub(' Graphics Controller$',''):gsub(' Mobile$',''):gsub('%s+',' '); return n .. (g.frequency ~= '' and (' @ '..g.frequency) or '') .. (g.dedicatedTotal ~= '' and (' ('..(g.dedicatedTotal:gsub('%.00 ',' '))..')') or '') .. (g.type ~= '' and (' ['..g.type..']') or '')" },
        { "type": "gpu", "hideType": "discrete",   "key": "󰢮  iGPU  ", "format": "lua:local g=...; local n=g.name:gsub('%(R%)',''):gsub('%(TM%)',''):gsub('^NVIDIA ',''):gsub('^GeForce ',''):gsub(' GPU$',''):gsub(' Graphics Controller$',''):gsub(' Mobile$',''):gsub('%s+',' '); return n .. (g.frequency ~= '' and (' @ '..g.frequency) or '') .. (g.dedicatedTotal ~= '' and (' ('..(g.dedicatedTotal:gsub('%.00 ',' '))..')') or '') .. (g.type ~= '' and (' ['..g.type..']') or '')" },
        { "type": "memory",  "key": "󰍛  RAM   " },
        { "type": "disk",    "key": "  Disk  " },
        { "type": "localip", "key": "󰩟  IP    " },
        "break",
        { "type": "custom", "format": "    {#38;2;72;96;72}●  {#38;2;110;134;110}●  {#38;2;147;165;134}●  {#38;2;182;195;166}●  {#38;2;226;230;216}●  {#38;2;199;184;154}●  {#38;2;134;110;110}●" },
        "break"
    ]
}